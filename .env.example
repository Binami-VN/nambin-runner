# Dashboard → Quản trị → Runner → Tạo (shown once)
NAMBIN_OPS_RUNNER_TOKEN=
# Coding agent (code_fix / code_review): at least one of the two.
# 1) Any OpenAI-compatible API, driven by OpenCode (npm i -g opencode-ai). Tried first.
#    OpenRouter: https://openrouter.ai/api/v1 · Groq: https://api.groq.com/openai/v1 · Ollama: http://localhost:11434/v1
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
# AGENT_LLM_API=responses   # only for endpoints without /chat/completions
# 2) Cursor API key → Cursor agent. Fallback when the first one fails.
CURSOR_API_KEY=
# AGENT_ENGINES=opencode,cursor
# Optional overrides of runner.config.json
# NAMBIN_OPS_URL=http://localhost:4100
# RUNNER_NAME=build-mac
# RUNNER_KINDS=code_fix,code_review,dependency_update,security_scan
